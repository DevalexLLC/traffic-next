{
  "name": "@devalexllc/traffic-next",
  "version": "0.1.2",
  "description": "First-party user-activity tracking for Next.js App Router apps. Client queue plus a route-handler factory; the app supplies the session and the sink.",
  "keywords": [
    "analytics",
    "app-router",
    "nextjs",
    "self-hosted",
    "telemetry"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevalexLLC/traffic-next.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "changeset": "changeset",
    "clean": "rm -rf dist",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.18",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "28.0.0",
    "lefthook": "2.1.9",
    "next": "16.3.1",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "oxlint-tsgolint": "0.23.0",
    "react": "19.2.0",
    "vitest": "4.1.8",
    "zod": "4.0.14"
  },
  "peerDependencies": {
    "next": ">=15.1.0",
    "react": ">=18.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": false
    },
    "react": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.10.1"
}
